# Publish only the addon, its tests, build tools, and documentation.
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/.github/
!/ForeverMacros/
!/tests/
!/tools/
!/README.md
!/CATALOG.md
!/VALIDATION.md
!/ATTACK-AUDIT.md
!/RESEARCH.md
!/SECURITY.md
!/LICENSE
!/requirements-dev.txt
!/docs/
!/docs/CI.md

/tools/*
!/tools/package.py
!/tools/artwork_assets.py

**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*
**/WTF/
**/SavedVariables/
**/macros-cache.txt
**/macros-cache.old
**/ForeverMacrosDB*
**/*.log
**/*.zip
**/*.bak
**/installation-receipt-*.json
